# Bitly Metrics Report — Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Generic access token from https://app.bitly.com/settings/api/
BITLY_ACCESS_TOKEN=your_bitly_access_token_here

# The group to report on. Leave blank and the script will auto-use the only
# group on the account (and print its guid); if there is more than one group
# it will list them so you can pick one.
BITLY_GROUP_GUID=

# ─── AWS SES — email sending ───────────────────────────────────────────────────
AWS_REGION=us-east-1

# Leave both blank to use the default credential chain (~/.aws/credentials or IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Must be a verified SES sender address/domain
FROM_ADDRESS=reports@yourdomain.com

# Comma-separated recipients — verified too if your SES account is in sandbox mode
TO_ADDRESSES=you@yourdomain.com,other@example.com

# ─── Report settings ────────────────────────────────────────────────────────────
# Number of days of history to report (overridable per-run with --days)
REPORT_DAYS=30

# Timezone for report date labels and chart axes (IANA name)
TIMEZONE=America/New_York
